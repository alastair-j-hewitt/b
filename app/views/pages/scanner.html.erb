<h1>Scan the QR code</h1>
<video id="preview" playsinline></video>
<p id="scanner-error" hidden></p>
<p><%= link_to "Cancel", home_path %></p>

<%# Instascan is served locally (public/js) because rawgit.com no longer exists. %>
<script src="/js/instascan.min.js"></script>
<script>
  (function () {
    var errorBox = document.getElementById("scanner-error");

    function showError(message) {
      errorBox.textContent = message;
      errorBox.hidden = false;
    }

    if (typeof Instascan === "undefined") {
      showError("The QR scanner library failed to load.");
      return;
    }

    var scanner = new Instascan.Scanner({ video: document.getElementById("preview") });

    scanner.addListener("scan", function (content) {
      // Store first, then navigate. The demo picks one of three sample transactions.
      sessionStorage.setItem("cont", content);
      scanner.stop();
      var id = Math.floor(Math.random() * 3) + 1;
      window.location.assign("/transactions/" + id);
    });

    Instascan.Camera.getCameras()
      .then(function (cameras) {
        if (cameras.length === 0) {
          showError("No camera found on this device.");
          return;
        }
        var rear = cameras.find(function (camera) {
          return /back|rear|environment/i.test(camera.name || "");
        });
        scanner.start(rear || cameras[0]);
      })
      .catch(function (err) {
        showError("Camera unavailable. Phones require HTTPS for camera access. (" + err.message + ")");
      });
  })();
</script>
