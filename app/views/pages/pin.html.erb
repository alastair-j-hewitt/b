<div class="row">
  <div class="col-sm-4 offset-sm-4">
    <h1>Enter your PIN</h1>
    <%# POST keeps the PIN out of the URL, browser history and access logs. %>
    <%= form_with url: summary_path, method: :post, local: true do |form| %>
      <div class="form-group">
        <%= form.label :pin, "PIN (4 to 6 digits)" %>
        <%= form.password_field :pin, class: "form-control", maxlength: 6, inputmode: "numeric",
                                      pattern: "\\d{4,6}", autocomplete: "off", required: true %>
      </div>
      <%= form.submit "Submit", class: "btn btn-primary" %>
    <% end %>
  </div>
</div>
