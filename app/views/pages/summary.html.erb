<div class="row">
  <div class="col-sm-4 offset-sm-4">
    <h1>Summary</h1>
    <% if @pin_valid %>
      <p>Payment authorized (demo).</p>
      <%= link_to "Start over", home_path, class: "btn btn-primary" %>
